$ Comments
$ Lattice stability is taken from Unary 5.0 in this TDB.
$                                                                         T.A. 
$
$------------------------------------------------------------------------------
 ELEMENT /-   ELECTRON_GAS              0.0000E+00  0.0000E+00  0.0000E+00 !
 ELEMENT VA   VACUUM                    0.0000E+00  0.0000E+00  0.0000E+00 !
 ELEMENT K    BCC_A2                    3.9098E+01  7.0835E+03  6.4672E+01 !
 ELEMENT NA   BCC_A2                    2.2990E+01  6.4475E+03  5.1447E+01 !

$------------------------------------------------------------------------------
 TYPE_DEFINITION % SEQ * !
 DEFINE_SYSTEM_DEFAULT ELEMENT 2 !
 DEFAULT_COMMAND DEF_SYS_ELEMENT VA /- !


$------------------------------------------------------------------------------
$ PARAMETERS FOR LIQUID    (K,NA)1
$------------------------------------------------------------------------------
 PHASE LIQUID  %  1  1.0  !
 CONSTITUENT LIQUID :K,NA :  !

 PARAMETER G(LIQUID,K;0)      200  +2.95388079e+03 -6.43295403e+01*T -2.65275085e-02*T**2 +3.08821742e-06*T**3; 2200 N !
 PARAMETER G(LIQUID,NA;0)     200  +2.97223558e+03 -4.99468470e+01*T -2.78217958e-02*T**2 +3.85960809e-06*T**3; 2300 N !

 PARAMETER G(LIQUID,K,NA;0)   200  +2738.543+1.413*T;           6000 N !
 PARAMETER G(LIQUID,K,NA;1)   200  -8.741+1.832*T;            6000 N !
 PARAMETER G(LIQUID,K,NA;2)   200  +240.989-0.304*T;            6000 N !


$------------------------------------------------------------------------------
$ FUNCTIONS FOR BCC_A2   (K,NA)1(VA)3
$------------------------------------------------------------------------------
 PHASE BCC_A2  %   2   1   3   !
 CONSTITUENT BCC_A2  :K,NA :VA :  !

 PARAMETER G(BCC_A2,K:VA;0)     200  +6.61438314e+02 -5.74288431e+01*T -2.65262987e-02*T**2 +3.08791920e-06*T**3; 2200 N !
 PARAMETER G(BCC_A2,NA:VA;0)    200  +3.28863699e+02 -4.29301014e+01*T -2.78091809e-02*T**2 +3.85650706e-06*T**3; 2300 N !

 PARAMETER G(BCC_A2,K,NA:VA;0)  200  +13399.512-11.004*T;       6000 N !
 PARAMETER G(BCC_A2,K,NA:VA;1)  200  +1200.161-1.000*T;         6000 N !


$------------------------------------------------------------------------------
$ K-NA BINARY COMPOUND PHASE 
$------------------------------------------------------------------------------
$ PARAMETERS FOR KNA2       (K)0.333(NA)0.667
$------------------------------------------------------------------------------
 PHASE KNA2  %   2  0.333   0.667 !
 CONSTITUENT KNA2  :K : NA :  !

 PARAMETER G(KNA2,K:NA;0)  298.15  +4.68227046e+02 -4.8091824e+01*T -2.19811e-02*T**2 +3.20056730e-06*T**3;  6000 N ! $11Ren


