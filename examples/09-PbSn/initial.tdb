$
$ Database for Pb-Sn from W. Gierlotka and Y.-C. Tung 2017.
$
$ W. Gierlotka, Y.-C. Tung, J. Phase Equilib. Diffus., 38, 814-28(2017).
$
$ Dataset created 2019.11.16 by Bengt Hallstedt.
$
$ The hcp phase becomes stable if the fcc interaction is used.
$
$ ------------------------------------------------------------------------------
 TEMP-LIM 298.15 6000.00 !
$
$ELEMENT NAME  REF. STATE               ATOMIC MASS H298-H0    S298    !
$
 ELEMENT VA   VACUUM                      0.0          0.0      0.0    ! 
 ELEMENT PB   FCC_A1                    207.2       6870.      64.80   ! 
 ELEMENT SN   BCT_A5                    118.69      6323.      51.18   ! 
 
 DEFINE-SYSTEM-DEFAULT ELEMENT 2 !
 DEFAULT-COM DEFINE_SYSTEM_ELEMENT VA !
 TYPE-DEF % SEQ * !
 TYPE-DEF A GES AMEND_PHASE_DESCRIPTION @ MAGNETIC -3 0.28 !
 TYPE-DEF B GES AMEND_PHASE_DESCRIPTION @ MAGNETIC -1 0.4 !

$ ------------------------------------------------------------------------------

 PHASE LIQUID:L % 1 1 !
 CONST LIQUID:L : PB SN : !
 PAR  G(LIQUID,PB),,                    +GLIQPB;                 2100 N 91Din !
 PAR  G(LIQUID,SN)              100.00  +GLIQSN;                 3000 N 91Din !
 PAR  L(LIQUID,PB,SN;0),,               +1000*a+b*T;,,           N 17Gie !
 PAR  L(LIQUID,PB,SN;1),,               +1000*a+b*T;,,                    N 17Gie !

 PHASE FCC_A1 %A 2 1 1 !
 CONST FCC_A1 : PB% SN : VA : !
 PAR  G(FCC_A1,PB:VA),,                 +GHSERPB;                2100 N 91Din !
 PAR  G(FCC_A1,SN:VA)           100.00  +GHSERSN+5510-8.46*T+1000*a+b*T;    3000 N 89Fec !
 PAR  L(FCC_A1,PB,SN:VA;0),,            +1000*a+b*T;,,           N 17Gie !
 PAR  L(FCC_A1,PB,SN:VA;1),,            +1000*a+b*T;,,                    N 17Gie !

 PHASE BCC_A2 %B 2 1 3 !
 CONST BCC_A2 : PB SN : VA : !
 PAR  G(BCC_A2,PB:VA),,                 +GHSERPB+2400-1.1*T+1000*a+b*T;     2100 N 91Din !
 PAR  G(BCC_A2,SN:VA)           100.00  +GHSERSN+4400-6*T+1000*a+b*T;       3000 N 91Din !
 PAR  L(BCC_A2,PB,SN:VA;0),,            +1000*a+b*T;,,           N Same !
 PAR  L(BCC_A2,PB,SN:VA;1),,            +1000*a+b*T;,,                    N Same !

 PHASE HCP_A3 %A 2 1 0.5 !
 CONST HCP_A3 : PB SN : VA : !
 PAR  G(HCP_A3,PB:VA),,                 +GHSERPB+300+T+1000*a+b*T;          2100 N 91Din !
 PAR  G(HCP_A3,SN:VA)           100.00  +GHSERSN+3900-7.646*T+1000*a+b*T;   3000 N Ansar !
 PAR  L(HCP_A3,PB,SN:VA;0),,            +1000*a+b*T;,,                     N Same !

 PHASE BCT_A5 % 1 1 !
 CONST BCT_A5 : PB SN% : !
 PAR  G(BCT_A5,PB),,                    +GHSERPB+489+3.52*T+1000*a+b*T;     2100 N 91Din !
 PAR  G(BCT_A5,SN)              100.00  +GHSERSN;                3000 N 91Din !
 PAR  L(BCT_A5,PB,SN;0),,               +1000*a+b*T+1000*a+b*T;,,           N 17Gie !

$ ------------------------------------------------------------------------------
 FUNCTION ZERO      298.15  0;                                         6000 N !
 FUNCTION UN_ASS    298.15  0;                                         6000 N !
 FUNCTION R         298.15  +8.31451;                                  6000 N !
 FUNCTION GHSERSN   100.00  -7958.517+122.765451*T-25.858*T*LN(T)
       +5.1185E-04*T**2-3.192767E-06*T**3+18440*T**(-1);
       250.00  Y  -5855.135+65.443315*T-15.961*T*LN(T)
       -0.0188702*T**2+3.121167E-06*T**3-61960*T**(-1);
       505.08  Y  +2524.724+4.005269*T-8.2590486*T*LN(T)
       -0.016814429*T**2+2.623131E-06*T**3-1081244*T**(-1)-1.2307E+25*T**(-9);
       800.00  Y  -8256.959+138.99688*T-28.4512*T*LN(T)-1.2307E+25*T**(-9);
      3000.00  N !
 FUNCTION GDIASN    100.00  -9579.608+114.007785*T-22.972*T*LN(T)
       -0.00813975*T**2+2.7288E-06*T**3+25615*T**(-1);
       298.15  Y  -9063.001+104.84654*T-21.5750771*T*LN(T)
       -0.008575282*T**2+1.784447E-06*T**3-2544*T**(-1);
       800.00  Y  -10909.351+147.396535*T-28.4512*T*LN(T);
      3000.00  N !
 FUNCTION GLIQSN    100.00  +7103.092-14.087767*T+GHSERSN+1.47031E-18*T**7;
       505.08  Y  +6971.586-13.814383*T+GHSERSN+1.2307E+25*T**(-9);
       800.00  Y  -1285.372+125.182498*T-28.4512*T*LN(T);
      3000.00  N !
 FUNCTION GBCCSN    298.15  +GHSERSN+4400-6*T;                         3000 N !
 FUNCTION GHSERPB   298.15  -7650.085+101.700244*T-24.5242231*T*LN(T)
       -0.00365895*T**2-2.4395E-07*T**3;
       600.61  Y  -10531.095+154.243182*T-32.4913959*T*LN(T)
       +0.00154613*T**2+8.05448E+25*T**(-9);
      1200.00  Y  +4157.616+53.139072*T-18.9640637*T*LN(T)
       -0.002882943*T**2+9.8144E-08*T**3-2696755*T**(-1)+8.05448E+25*T**(-9);
      2100.00  N !
 FUNCTION GLIQPB    298.15  +4672.124-7.750683*T+GHSERPB-6.019E-19*T**7;
       600.61  Y  +4853.137-8.067136*T+GHSERPB-8.05448E+25*T**(-9);
      2100.00  N !
