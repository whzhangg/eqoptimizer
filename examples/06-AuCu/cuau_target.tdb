TEMP-LIM 298.15 6000.00 !
ELEMENT AU   FCC_A1                    196.9665    6016.592   47.4884 ! 
ELEMENT CU   FCC_A1                     63.546     5004.      33.15   !

TYPE_DEFINITION % SEQ *!

PHASE FCC % 1 1.0 !
CONSTITUENT FCC : AU, CU : !
PARAMETER G(FCC,AU;0) 100 0.0; 3000 N !
PARAMETER G(FCC,CU;0) 100 0.0; 3000 N !

PAR  L(FCC,AU,CU;0) 100  +4*ALAN+0.75*LAUAU+1.5*LAUCU+0.75*LCUCU+0.25*AUCUG1;  N !
PAR  L(FCC,AU,CU;1) 100  +1.5*LAUAU-1.5*LCUCU+0.25*AUCUG2;                     N !
PAR  L(FCC,AU,CU;2) 100  -3*LAUCU+0.25*AUCUG3;       N 98Sun !
$PAR  L(FCC,AU,CU;3) 100  -1.5*LAUAU+1.5*LCUCU;,,       N 98Sun !
$PAR  L(FCC,AU,CU;4) 100 -0.75*LAUAU+1.5*LAUCU-0.75*LCUCU;,, N !                          

PHASE AU3CU % 2 0.75 0.25 !
CONSTITUENT AU3CU : AU : CU : !
PARAMETER G(AU3CU,AU:CU;0) 100 -4020 - 2240; 3000 N !

PHASE AUCU3 % 2 0.25 0.75 !
CONSTITUENT AUCU3 : AU : CU : !
PARAMETER G(AUCU3,AU:CU;0) 100 -5250 - 3109; 3000 N !

PHASE AUCU % 2 0.5 0.5 !
CONSTITUENT AUCU : AU : CU : !
PARAMETER G(AUCU,AU:CU;0) 100 -6260 - 3947; 3000 N !

FUNCTION LAUAU     298.15  0;                                   6000 N !
FUNCTION LAUCU     298.15  0;                                   6000 N !
FUNCTION LCUCU     298.15  -1987.5;                            6000 N !
FUNCTION GAU3CU1   298.15  -34590;                      6000 N !
FUNCTION GAU2CU2   298.15  -54120-6.26;                 6000 N !
FUNCTION GAU1CU3   298.15  -41520-4.695;                      6000 N !
FUNCTION AUCUG1    298.15  +GAU3CU1+1.5*GAU2CU2+GAU1CU3;              6000 N !
FUNCTION AUCUG2    298.15  +2*GAU3CU1-2*GAU1CU3;                      6000 N !
FUNCTION AUCUG3    298.15  +GAU3CU1-1.5*GAU2CU2+GAU1CU3;              6000 N !
FUNCTION ALAN      298.15  +3940;                             6000 N !
FUNCTION RAU3CU1   298.15  +0.25*GAU3CU1;                             6000 N !
FUNCTION RAU2CU2   298.15  +0.25*GAU2CU2;                             6000 N !
FUNCTION RAU1CU3   298.15  +0.25*GAU1CU3;                             6000 N !