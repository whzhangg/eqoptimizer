  PARA G(BCC_A2,TA:VA;0)    298.15 +1.24547206e+04 -4.09818078e+01*T -1.80300802e-02*T**2 +1.56762281e-06*T**3;                6000 N !
  PARA G(BCC_A2,W:VA;0)     298.15 +1.23799862e+04 -3.21927453e+01*T -1.73174730e-02*T**2 +1.42131831e-06*T**3;                 6000 N !
  PARA G(BCC_A2,ZR:VA;0)    298.15 +1.98416679e+04 -4.71848189e+01*T -1.70393558e-02*T**2 +1.28887803e-06*T**3;                 6000 N !
  PARA G(BCC_A2,TA,W:VA;0)  298.15 -26740.7+4.7010*T;       6000 N ! 
  PARA G(BCC_A2,TA,W:VA;1)  298.15 -7355.0+1.4538*T;        6000 N ! 
  PARA G(BCC_A2,TA,ZR:VA;0) 298.15 +29499.6+2.6723*T;       6000 N ! 
