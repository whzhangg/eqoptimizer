$                  
 ELEMENT /-   ELECTRON_GAS              0.0000E+00  0.0000E+00  0.0000E+00!
 ELEMENT VA   VACUUM                    0.0000E+00  0.0000E+00  0.0000E+00!
 ELEMENT RE   HCP_A3                    1.8621E+02  5.3555E+03  3.6526E+01!
 ELEMENT W    BCC_A2                    1.8385E+02  4.9700E+03  3.2620E+01!
$--------1---------2---------3---------4---------5---------6---------7---------8 
$ RE
 FUNCTION GHSERRE 300 -7305.045+123.758773*T-23.6892641*T*LN(T)
     -.002723387*T**2;  3.45900E+03  Y
      +38514.17-65.920606*T+.0645635*T*LN(T)-.008050184*T**2
     +2.19551E-07*T**3-15938253*T**(-1);  6.00000E+03  N !
 FUNCTION GLIQRE  300 +37991.663+112.574475*T-23.6892641*T*LN(T)
     -.002723387*T**2;  1.00000E+03  Y
      +66060.979-113.540121*T+7.4580354*T*LN(T)-.016183804*T**2
     +7.69496E-07*T**3-4421721*T**(-1);      3459 Y
      -5301.43+328.158541*T-50*T*LN(T);      6000 N !
 FUNCTION GFCCRE  300  +11000-1.5*T+GHSERRE; 6000 N !
 FUNCTION GBCCRE  300  +29200-6.0*T+GHSERRE; 6000 N !
 FUNCTION UN_ASS 300 0; 300 N !
$ W
   FUNCTION GLIQWW 300 +44514.273+116.29001*T-24.1*T*LN(T)
  -.001936*T**2+2.07E-07*T**3+44500*T**(-1)-5.33E-11*T**4-2.713468E-24*T**7; 
   3.69500E+03  Y
   -30436.051+375.175*T-54*T*LN(T); 6000 N  !
   FUNCTION GHSERW 300 -7646.311+130.4*T-24.1*T*LN(T)
  -.001936*T**2+2.07E-07*T**3+44500*T**(-1)-5.33E-11*T**4;  3.69500E+03  Y
   -82868.801+389.362335*T-54*T*LN(T)+1.528622E+33*T**(-9); 6000 N !
   FUNCTION GFCCWW 300 +11653.689+131.03*T-24.1*T*LN(T)
  -.001936*T**2+2.07E-07*T**3+44500*T**(-1)-5.33E-11*T**4;  3.69500E+03  Y
   -63568.801+389.992335*T-54*T*LN(T)+1.528622E+33*T**(-9); 6000 N !
   FUNCTION GHCPWW 300 +7103.689+130.4*T-24.1*T*LN(T)
  -.001936*T**2+2.07E-07*T**3+44500*T**(-1)-5.33E-11*T**4;  3.69500E+03  Y
   -68118.801+389.362335*T-54*T*LN(T)+1.528622E+33*T**(-9); 6000 N !
$
$ ------------------------------------------------------------------------------ 
 TYPE_DEFINITION % SEQ *!
 DEFINE_SYSTEM_DEFAULT ELEMENT 2 !
 DEFAULT_COMMAND DEF_SYS_ELEMENT VA /- !
$
$ ------------------------------------------------------------------------------ 
$ SOLUTION PHASES
$ ------------------------------------------------------------------------------ 
$
 PHASE LIQUID %  1  1.0  !
    CONSTITUENT LIQUID : RE,W :  !
   PARAMETER G(LIQUID,W;0)     300 +GLIQWW;             6000 N !
   PARAMETER G(LIQUID,RE;0)    300 +GLIQRE;             6000 N !
   PARAMETER G(LIQUID,RE,W;0)  300 -24140;              6000 N !
   PARAMETER G(LIQUID,RE,W;1)  300 -5723;               6000 N !

 PHASE BCC  %  1  1  !
    CONSTITUENT BCC  : RE,W :  !
   PARAMETER G(BCC,W;0)     300 +GHSERW;             6000 N !
   PARAMETER G(BCC,RE;0)    300 +GBCCRE;             6000 N !
   PARAMETER G(BCC,RE,W;0)  300 -48975+8.982*T;      6000 N !
   PARAMETER G(BCC,RE,W;1)  300 +11855;              6000 N !

 PHASE HCP  %  1  1  !
    CONSTITUENT HCP  : RE,W :  !
   PARAMETER G(HCP,W;0)     300 +GHCPWW;             6000 N !
   PARAMETER G(HCP,RE;0)    300 +GHSERRE;            6000 N !
   PARAMETER G(HCP,RE,W;0)  300 -7986;               6000 N !
$
$ ------------------------------------------------------------------------------ 
$ TCP PHASES
$ ------------------------------------------------------------------------------ 
$
 PHASE SIGMA  %  3  8  4  18  !
    CONSTITUENT SIGMA  : RE : W : RE,W :  !
 PARAMETER G(SIGMA,RE:W:W;0)    300 
                     -173062-93.0315*T+8*GFCCRE+4*GHSERW+18*GHSERW; 6000 N !
 PARAMETER G(SIGMA,RE:W:RE;0)    300 
                     -722095+119.741*T+8*GFCCRE+4*GHSERW+18*GBCCRE;  6000 N !
 PARAMETER G(SIGMA,RE:W:RE,W;0) 300 +159160;                       6000 N !

$
 PHASE CHI  %  3  24  10  24  !
    CONSTITUENT CHI  : RE : RE,W : RE,W :  !
 PARAMETER G(CHI,RE:RE:W;0)    300 +100000-692194-187.085*T+832016-61.502*T
                                     +24*GFCCRE+10*GBCCRE+24*GFCCWW;  6000 N !
 PARAMETER G(CHI,RE:RE:RE;0)    300 
                             +100000 +24*GFCCRE+10*GBCCRE +24*GFCCRE; 6000 N !
 PARAMETER G(CHI,RE:W:W;0)    300 
                    -692194-187.085*T+24*GFCCRE+10*GHSERW+24*GFCCWW; 6000 N !
 PARAMETER G(CHI,RE:W:RE;0)    300 
                     -832016+61.502*T+24*GFCCRE+10*GHSERW+24*GFCCRE; 6000 N !
 PARAMETER G(CHI,RE:RE:RE,W;0) 300 +0;                               6000 N !
 PARAMETER G(CHI,RE:W:RE,W;0)  300 +0;                               6000 N !
 PARAMETER G(CHI,RE:RE,W:RE;0) 300 +0;                               6000 N !
 PARAMETER G(CHI,RE:RE,W:W;0)  300 +0;                               6000 N !
$
$TARE-NIMS




