  PARAMETER G(HCP_A3,TA;0)    298.15 +1.33632410e+04 -3.52938792e+01*T -2.06041162e-02*T**2 +2.13791952e-06*T**3; 6000 N !
  PARAMETER G(HCP_A3,W;0)     298.15 +1.61082774e+04 -2.91119088e+01*T -1.97312757e-02*T**2 +1.95648468e-06*T**3; 6000 N !
  PARAMETER G(HCP_A3,ZR;0)    130    +8.82735628e+02 -3.32134836e+01*T -2.33280616e-02*T**2 +2.18767039e-06*T**3; 6000 N !
  PARAMETER G(HCP_A3,TA,ZR;0) 298.15 +30051.7;                6000 N ! 
  PARAMETER G(HCP_A3,W,ZR;0)  298.15 +8026.3+6.9345*T;        6000 N !

