$ PARAMETERS ARE TAKEN FROM
$ A thermodynamic analysis of the Pb-Sn system and 
$ the calculation of the Pb-Sn phase diagram, 
$ T.L.Ngai, Y.A.Chang, CALPHAD, 5 (1981) 267-276.
$
$ ------------------------------------------------------------------------------
$
 ELEMENT /-   ELECTRON_GAS              0.0000E+00  0.0000E+00  0.0000E+00!
 ELEMENT VA   VACUUM                    0.0000E+00  0.0000E+00  0.0000E+00!
 ELEMENT PB   FCC_A1                    2.0720E+02  6.8785E+03  6.4785E+01!
 ELEMENT SN   BCT_A5                    1.1871E+02  6.3220E+03  5.1195E+01! 
$-------------------------------------------------------------------------------
 TYPE_DEFINITION % SEQ *!
 DEFINE_SYSTEM_DEFAULT ELEMENT 2 !
 DEFAULT_COMMAND DEF_SYS_ELEMENT VA /- !

$-------------------------------------------------------------------------------
$ PARAMETERS FOR LIQUID PHASE
$-------------------------------------------------------------------------------
 PHASE LIQUID %  1  1.0  !
    CONSTITUENT LIQUID :PB,SN :  !
   PARAMETER G(LIQUID,PB;0)     298.15   +2.59207784e+03 -5.45121985e+01*T -3.78965961e-02*T**2 +7.46344817e-06*T**3; 5000 N !
   PARAMETER G(LIQUID,SN;0)     298.15   +5.34567823e+03 -4.85916992e+01*T -3.65734732e-02*T**2 +7.19771829e-06*T**3; 4000 N !
   PARAMETER G(LIQUID,PB,SN;0)  298.15   +5125+1.46424*T;               6000 N !
   PARAMETER G(LIQUID,PB,SN;1)  298.15   +293.82;                       6000 N !

PHASE FCC_A1 % 2 1.0 1.0 !
CONSTITUENT FCC_A1 : PB,SN : VA : !
PARAMETER G(FCC_A1,PB:VA;0) 10.0  -2.07564955E+03 -4.71724630E+01*T -3.71265655E-02*T**2 +7.34344114E-06*T**3 ; 6000 N !
PARAMETER G(FCC_A1,SN:VA;0) 10.0  +1.84491260E+03 -3.95440346E+01*T -3.66667553E-02*T**2 +7.97743728E-06*T**3 ; 6000 N !
PARAMETER G(FCC_A1,PB,SN:VA;0) 10.0  +6.45529773E+03 +1.01206837E-01*T ; 6000 N !
PHASE BCT_A5 % 2 1.0 3.0 !
CONSTITUENT BCT_A5 : PB,SN : VA : !
PARAMETER G(BCT_A5,PB:VA;0) 10.0  +6.65688339E+02 -4.16386602E+01*T -3.53133257E-02*T**2 +8.98450859E-06*T**3 ; 6000 N !
PARAMETER G(BCT_A5,SN:VA;0) 10.0  -1.60616212E+03 -3.44410833E+01*T -3.73652645E-02*T**2 +6.84397380E-06*T**3 ; 6000 N !
PARAMETER G(BCT_A5,PB,SN:VA;0) 10.0  +1.25082071E+04 -9.58476019E+00*T ; 6000 N !

$PB-SN
 