$ ------------------------------------------------------------------------------
$ PARAS ARE TAKEN FROM
$
$ Thermodynamic description of the Ta-W-Zr system,
$ C.Guo, C.Li, S.Shang, Z.Du, Int. J. Mater. Res., 105 (2014) 1048-1056.
$
$ 95Gui: Ta-Zr Ref.[15] 
$ Phase diagram and thermochemical properties of the Zr-Ta system  
$   An assessment based on Gibbs energy modelling,
$ A.F.Guillerment, J. Alloys Compd. , 226(1995), 174-184.
$ 
$ ------------------------------------------------------------------------------
$ Comments
$ Lattice stability is taken from Unary 5.0.
$ 
$ The vertical section in Fig. 11 can not be reproduced. As other 
$ figures are OK, it is not clear the reasons why.
$                                                                         T.A.
$
$ ------------------------------------------------------------------------------
 ELEMENT /-   ELECTRON_GAS              0.0000E+00  0.0000E+00  0.0000E+00!
 ELEMENT VA   VACUUM                    0.0000E+00  0.0000E+00  0.0000E+00!
 ELEMENT TA   BCC_A2                    1.8095E+02  5.6819E+03  4.1472E+01 !
 ELEMENT W    BCC_A2                    1.8385E+02  4.9700E+03  3.2620E+01 !
 ELEMENT ZR   HCP_A3                    9.1224E+01  5.5663E+03  3.9181E+01 !

$ ------------------------------------------------------------------------------
 TYPE_DEFINITION % SEQ *!
 DEFINE_SYSTEM_DEFAULT ELEMENT 2 !
 DEFAULT_COMMAND DEF_SYS_ELEMENT VA /- !

$ ------------------------------------------------------------------------------
$  PARAS FOR LIQUID
$ ------------------------------------------------------------------------------
 PHASE LIQUID  %  1  1.0  !
    CONSTITUENT LIQUID  : TA,W,ZR :  !
  PARA G(LIQUID,TA;0)      298.15 +4.13579932e+04 -4.80138203e+01*T -1.80975524e-02*T**2 +1.42442611e-06*T**3; 6000 N !
  PARA G(LIQUID,W;0)       298.15 +6.45430059e+04 -4.63104412e+01*T -1.73108779e-02*T**2 +1.41964741e-06*T**3; 6000 N !
  PARA G(LIQUID,ZR;0)      298.15 +2.97797079e+04 -4.45497587e+01*T -2.15764310e-02*T**2 +1.80694759e-06*T**3; 6000 N !
  PARA G(LIQUID,TA,W;0)    298.15 -12711.6;                 6000 N !
  PARA G(LIQUID,TA,W;1)    298.15 -3504.1;                  6000 N !
  PARA G(LIQUID,TA,ZR;0)   298.15 +13832.1;                 6000 N ! 
  PARA G(LIQUID,TA,ZR;1)   298.15 -7150;                    6000 N ! 
  PARA G(LIQUID,W,ZR;0)    298.15 -48980+27.9599*T;         6000 N !
  PARA G(LIQUID,W,ZR;1)    298.15 -4645.4+0.7655*T;         6000 N !
  PARA G(LIQUID,W,ZR;2)    298.15 -8597.1+6.1958*T;         6000 N !
  PARA G(LIQUID,TA,W,ZR;0) 298.15 +0;                       6000 N ! 
  PARA G(LIQUID,TA,W,ZR;1) 298.15 +0;                       6000 N ! 
  PARA G(LIQUID,TA,W,ZR;2) 298.15 +64980.9;                 6000 N !

$ ------------------------------------------------------------------------------
$  PARAS FOR HCP_A3
$ ------------------------------------------------------------------------------
 PHASE HCP_A3  %  2 1   .5 !
    CONSTITUENT HCP_A3  : TA,W,ZR : VA :  !
  PARA G(HCP_A3,TA:VA;0)    298.15 +2.44547206e+04 -3.85818078e+01*T -1.80300802e-02*T**2 +1.56762281e-06*T**3; 6000 N !
  PARA G(HCP_A3,W:VA;0)     298.15 +2.71299862e+04 -3.21927453e+01*T -1.73174730e-02*T**2 +1.42131831e-06*T**3; 6000 N !
  PARA G(HCP_A3,ZR:VA;0)    130    +1.16139248e+04 -3.54286879e+01*T -2.15874122e-02*T**2 +1.80091607e-06*T**3; 6000 N !
  PARA G(HCP_A3,TA,ZR:VA;0) 298.15 +30051.7;                6000 N ! 
  PARA G(HCP_A3,W,ZR:VA;0)  298.15 +8026.3+6.9345*T;        6000 N !

