  PARA G(BCC_A2,TA,W,ZR:VA;2)  298.15 -149416.3;            6000 N !

$-------------------------------------------------------------------------------
$ PARAS FOR COMPOUNDS
$-------------------------------------------------------------------------------
 PHASE W2ZR  %  2 2   1 !
    CONSTITUENT W2ZR  : TA,W : ZR :  !
  PARA G(W2ZR,TA:ZR;0) 298.15  +3.31692177e+04 -1.08601242e+02*T -6.45362941e-02*T**2 +6.46350942e-06*T**3;         3000 N !
  PARA G(W2ZR,W:ZR;0)  298.15  -9.78630949e+03 -8.55795011e+01*T -6.27906130e-02*T**2 +6.10063976e-06*T**3; 3000 N !
  PARA G(W2ZR,TA,W:ZR;0) 298.15  -40744.8-2.9025*T;                6000 N !
